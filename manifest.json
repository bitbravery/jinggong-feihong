{
  "manifest_version": 3,
  "name": "京工飞鸿 · 本机接入工作台",
  "version": "0.9.203",
  "description": "点击扩展连接当前已登录的学校页面，读取原站结果并通过原站表单办理。无外部服务器。",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "background": {
    "service_worker": "worker.js"
  },
  "action": {
    "default_title": "连接当前学校页面并打开飞鸿工作台",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; connect-src 'none'"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
